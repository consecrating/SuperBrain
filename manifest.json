{
  "$comment": "EXECUTABLE spec. scripts/bootstrap.sh, verify.sh and repair.sh all read this file — it is the single source of truth. Do not duplicate install logic into the shell scripts. Placeholders ${WORKSPACE}, ${KIRO_DIR}, ${KIRO_SKILLS}, ${REPO} are expanded before execution.",
  "name": "SuperBrain",
  "version": "2.0.0",
  "description": "Auto-bootstrap manifest — declares all repos, install order, and verification checks.",
  "author": "consecrating",

  "workspace": "/projects/sandbox",
  "kiro_dir": "/projects/.kiro",
  "python_bin": "/root/.pyenv/versions/3.11.15/bin",

  "repositories": [
    {
      "name": "All-Skills",
      "github": "consecrating/All-Skills",
      "branch": null,
      "purpose": "Design/UX/WordPress Kiro skills",
      "priority": 1,
      "skills_dir": ".kiro/skills",
      "install": [
        "KIRO_SKILLS_DIR=${KIRO_SKILLS} bash ./install.sh"
      ],
      "verify": [
        "test -d ${KIRO_SKILLS}/ui-ux-pro-max"
      ]
    },
    {
      "name": "Claude-Power",
      "github": "consecrating/Claude-Power",
      "branch": null,
      "purpose": "Engineering Kiro skills + steering + scripts",
      "priority": 2,
      "skills_dir": ".kiro/skills",
      "install": [
        "cp -r .kiro/skills/. ${KIRO_SKILLS}/",
        "test -d .kiro/steering && cp -r .kiro/steering/. ${KIRO_DIR}/steering/ || true",
        "test -d .kiro/scripts && cp -r .kiro/scripts/. ${KIRO_DIR}/scripts/ || true"
      ],
      "verify": [
        "test -f ${KIRO_SKILLS}/token-efficiency/SKILL.md"
      ]
    },
    {
      "name": "AIBrain",
      "github": "consecrating/AIBrain",
      "branch": null,
      "purpose": "Persistent intelligence layer — memory, patterns, stack, self-healing",
      "priority": 3,
      "skills_dir": ".kiro/skills",
      "install": [
        "bash scripts/install.sh"
      ],
      "verify": [
        "test -f ${KIRO_SKILLS}/aibrain/SKILL.md",
        "test -f ${KIRO_DIR}/steering/aibrain.md"
      ]
    },
    {
      "name": "ScrapeToolAi",
      "github": "consecrating/ScrapeToolAi",
      "branch": null,
      "purpose": "Stealth web scraping framework + AI extraction + MCP server",
      "priority": 4,
      "install": [
        "pip install -e . --quiet"
      ],
      "verify": [
        "python3 -c 'import scrapetoolai'",
        "command -v scrapetool"
      ]
    },
    {
      "name": "goaaiseo-seo-adapter",
      "github": "consecrating/goaaiseo-seo-adapter",
      "branch": null,
      "purpose": "Integration adapter: claude-seo -> GOAAISEO graph model",
      "priority": 5,
      "install": [
        "pip install -e . --quiet"
      ],
      "verify": [
        "python3 -c 'from gsa import models, normalize, sinks'",
        "command -v gsa"
      ]
    },
    {
      "name": "goaaiseo",
      "github": "consecrating/goaaiseo",
      "branch": null,
      "purpose": "Autonomous SEO Operating System (blueprint/architecture)",
      "priority": 6,
      "install": [],
      "verify": [
        "test -d docs/blueprint"
      ]
    }
  ],

  "self": {
    "name": "SuperBrain",
    "skills_dir": ".kiro/skills",
    "install": [
      "cp -r .kiro/steering/. ${KIRO_DIR}/steering/",
      "cp -r .kiro/skills/. ${KIRO_SKILLS}/"
    ],
    "verify": [
      "test -f ${KIRO_DIR}/steering/superbrain.md",
      "test -f ${KIRO_SKILLS}/superbrain/SKILL.md"
    ]
  },

  "environment": {
    "GOAAISEO_ROOT": "${WORKSPACE}/goaaiseo",
    "GOAAISEO_BLUEPRINT": "${WORKSPACE}/goaaiseo/docs/blueprint",
    "GSA_SINK": "jsonfile",
    "GSA_SINK_PATH": "${WORKSPACE}/goaaiseo-seo-adapter/out/site.graph.json",
    "GSA_MIN_CONFIDENCE": "0.7",
    "SCRAPETOOL_OUTPUT": "${WORKSPACE}/ScrapeToolAi/output",
    "SCRAPETOOL_IMPORTS": "${WORKSPACE}/ScrapeToolAi/imports",
    "KIRO_SKILLS_DIR": "${KIRO_SKILLS}",
    "AIBRAIN_ROOT": "${WORKSPACE}/AIBrain",
    "SUPERBRAIN_ROOT": "${WORKSPACE}/SuperBrain"
  },

  "post_install": [
    "chmod +x ${KIRO_DIR}/scripts/*.sh 2>/dev/null || true",
    "find ${KIRO_SKILLS} -name '*.sh' -exec chmod +x {} + 2>/dev/null || true",
    "chmod +x ${WORKSPACE}/AIBrain/scripts/*.sh 2>/dev/null || true",
    "mkdir -p ${WORKSPACE}/goaaiseo-seo-adapter/out",
    "mkdir -p ${WORKSPACE}/ScrapeToolAi/output ${WORKSPACE}/ScrapeToolAi/imports"
  ]
}
